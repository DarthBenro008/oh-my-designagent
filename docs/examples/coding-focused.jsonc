{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // Execution-heavy design preset.
  // Useful when most work is direct comment resolution and canvas mutation.

  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p5",
      "prompt_append": "Bias toward direct comment-resolution flow. Use explore and librarian only when context is genuinely missing."
    },

    "hephaestus": {
      "model": "openai/gpt-5.4",
      "prompt_append": "Own deeper design tasks, but stay grounded in project docs and Figma context."
    },

    "atlas": {
      "model": "anthropic/claude-sonnet-4-6",
      "prompt_append": "Prefer direct patch paths for clear low-risk comments. Retry once when review finds a fixable issue."
    },

    "metis": {
      "model": "openai/gpt-5.4-mini",
      "prompt_append": "Optimize for fast and explicit classification of comment type, scope, and confidence."
    },

    "momus": {
      "model": "google/gemini-3.1-pro",
      "variant": "high",
      "prompt_append": "Be strict about visible regressions and weak visual hierarchy."
    },

    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high"
    },

    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1
    },

    "librarian": { "model": "github-copilot/grok-code-fast-1" },
    "explore": { "model": "github-copilot/grok-code-fast-1" },
    "multimodal-looker": { "model": "google/gemini-3.1-pro" }
  },

  "design_memory": {
    "enabled": true,
    "docs_first": true,
    "docs_root": "docs",
    "docs_globs": ["**/*.md", "**/*.mdx", "**/*.jsonc"],
    "prefer_docs_types": ["design_style", "copy_context"],
    "auto_load_for_comment_resolution": true,
    "max_docs_files": 3,
    "max_chars_per_file": 1800,
    "max_total_chars": 7200
  },

  "figma_use": {
    "enabled": true,
    "mcp_server_name": "figma-use",
    "require_status_check": true
  },

  "figma": {
    "comment_resolution": {
      "enabled": true,
      "auto_reply": true,
      "max_variants": 2,
      "require_review_above_difficulty": "medium",
      "memory_required_for": ["layout_change", "new_component"]
    }
  },

  "background_task": {
    "defaultConcurrency": 8,
    "providerConcurrency": {
      "anthropic": 5,
      "openai": 5,
      "google": 10,
      "github-copilot": 10,
      "opencode": 15
    }
  },

  "experimental": { "aggressive_truncation": true, "task_system": true }
}
