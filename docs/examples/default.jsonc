{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // Baseline design-comment workflow.
  // Good default for teams resolving Figma comments with docs-first memory.

  "agents": {
    // Solacy: default design lead
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "prompt_append": "Treat docs memory as binding context before routing execution."
    },

    // Design Worker
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "prompt_append": "Explore product and design context before proposing broader visual changes."
    },

    // Comment Conductor
    "atlas": {
      "model": "anthropic/claude-sonnet-4-6",
      "prompt_append": "Always route non-trivial comment work through planner, executor, review, and audit."
    },

    // Comment Planner
    "metis": {
      "model": "openai/gpt-5.4-mini",
      "reasoningEffort": "medium",
      "prompt_append": "Classify requests clearly and stop for clarification when context conflicts."
    },

    // Vision Reviewer
    "momus": {
      "model": "google/gemini-3.1-pro",
      "variant": "high",
      "prompt_append": "Judge whether the visual result actually resolves the comment."
    },

    // Design Auditor
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "Prioritize token use, spacing consistency, hierarchy, and structure."
    },

    // Canvas Executor
    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1
    },

    "librarian": { "model": "google/gemini-3-flash" },
    "explore": { "model": "github-copilot/grok-code-fast-1" },
    "multimodal-looker": { "model": "google/gemini-3.1-pro" }
  },

  "design_memory": {
    "enabled": true,
    "docs_first": true,
    "docs_root": "docs",
    "docs_globs": ["**/*.md", "**/*.mdx", "**/*.jsonc"],
    "prefer_docs_types": ["design_style", "product_context"],
    "auto_load_for_comment_resolution": true,
    "max_docs_files": 4,
    "max_chars_per_file": 2400,
    "max_total_chars": 9600
  },

  "figma_use": {
    "enabled": true,
    "mcp_server_name": "figma-use",
    "require_status_check": true
  },

  "figma": {
    "comment_resolution": {
      "enabled": true,
      "auto_reply": true,
      "max_variants": 3,
      "require_review_above_difficulty": "medium",
      "memory_required_for": ["new_component", "layout_change", "design_improvement"]
    }
  },

  // Optional hard budget cap:
  // export OPENCODE_SESSION_BUDGET_USD=0.50

  "background_task": {
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 5,
      "opencode": 10
    }
  },

  "experimental": { "aggressive_truncation": true }
}
