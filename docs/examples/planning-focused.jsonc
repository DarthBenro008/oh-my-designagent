{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // Planning and review-heavy design preset.
  // Useful when comments imply broader layout, product, or system decisions.

  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "prompt_append": "Load docs memory first and prefer clarification over premature mutation."
    },

    "hephaestus": {
      "model": "openai/gpt-5.4",
      "prompt_append": "Treat broader design work as a product and system problem, not only a visual patch."
    },

    "atlas": {
      "model": "anthropic/claude-sonnet-4-6",
      "prompt_append": "Require planner context and explicit review before accepting medium or hard comment work."
    },

    "metis": {
      "model": "anthropic/claude-opus-4-6",
      "prompt_append": "Be exhaustive about memory selection, scope definition, and clarification triggers."
    },

    "momus": {
      "model": "google/gemini-3.1-pro",
      "variant": "high",
      "prompt_append": "Challenge weak variants and call out visual or intent mismatch directly."
    },

    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },

    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.1
    },

    "librarian": { "model": "google/gemini-3-flash" },
    "explore": { "model": "github-copilot/grok-code-fast-1" },
    "multimodal-looker": { "model": "google/gemini-3.1-pro", "variant": "high" }
  },

  "design_memory": {
    "enabled": true,
    "docs_first": true,
    "docs_root": "docs",
    "docs_globs": ["**/*.md", "**/*.mdx", "**/*.jsonc"],
    "prefer_docs_types": ["product_context", "user_behavior", "historical_learnings"],
    "auto_load_for_comment_resolution": true,
    "max_docs_files": 5,
    "max_chars_per_file": 2200,
    "max_total_chars": 10000
  },

  "figma_use": {
    "enabled": true,
    "mcp_server_name": "figma-use",
    "require_status_check": true
  },

  "figma": {
    "comment_resolution": {
      "enabled": true,
      "auto_reply": true,
      "max_variants": 3,
      "require_review_above_difficulty": "easy",
      "memory_required_for": ["layout_change", "new_component", "design_improvement"]
    }
  },

  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3
    }
  },

  "experimental": { "aggressive_truncation": true }
}
